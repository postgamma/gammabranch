-- B.9 MAIN re-entry: BranchScan must not leak into MAIN mode.
RESET overlay_branch.current;
SELECT CASE WHEN tag = 'gamma' THEN 'PASS:ADV_B_ID3_BACK_IN_MAIN'
            ELSE 'FAIL:'||COALESCE(tag,'NULL') END AS adv_b_id3_main_back
