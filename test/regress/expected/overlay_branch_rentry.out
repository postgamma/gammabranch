  BEGIN
    PERFORM public.use_branch('br_a7');
    RAISE WARNING 'FAIL:A7_D6 — use_branch did not raise 55000 for DROP table drift';
  EXCEPTION WHEN object_not_in_prerequisite_state THEN
    NULL;
  WHEN OTHERS THEN
