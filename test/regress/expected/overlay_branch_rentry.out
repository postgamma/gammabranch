    EXCEPTION WHEN OTHERS THEN _sqlstate := SQLSTATE;
    END;
    IF _sqlstate IS DISTINCT FROM '23502' THEN
        RAISE EXCEPTION 'FAIL_R23_F: expected 23502 got %', COALESCE(_sqlstate, '<no error>');
    END IF;
END $$;
