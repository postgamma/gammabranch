 WHERE NOT EXISTS (SELECT 1 FROM public.pg_branch WHERE branch_name='br_g01_should_fail_k2');
              g01_k_dom_label               
--------------------------------------------
 PASS:G01_SCOPE_K_CITEXT_DOMAIN_PK_REJECTED
