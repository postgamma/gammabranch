 WHERE NOT EXISTS (SELECT 1 FROM public.pg_branch WHERE branch_name='br_g01_should_fail_k3');
              g01_k_arr_label              
-------------------------------------------
 PASS:G01_SCOPE_K_CITEXT_ARRAY_PK_REJECTED
