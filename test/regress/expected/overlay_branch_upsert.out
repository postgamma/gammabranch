DELETE FROM public.bs_AA_up WHERE id = 1;
INSERT INTO public.bs_AA_up VALUES (1, 'reborn1')
  ON CONFLICT (id) DO NOTHING
  RETURNING id, v;
 id |    v    
----+---------
  1 | reborn1
(1 row)

