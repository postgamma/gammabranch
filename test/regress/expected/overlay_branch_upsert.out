/*
 * overlay_branch_upsert.sql — Pure Delta UPSERT (ON CONFLICT ... DO UPDATE/NOTHING) +
 *                             apply/discard three-phase dependency chain.
 *
 * COVERAGE (formerly overlay_branch_advanced.sql Section S + T + U, order-dependent, must not be interrupted):
 *   Section S — Pure Delta UPSERT 2-phase MAIN-first conflict detection:
 *               Phase I pure-delta SPI same-key lookup; Phase II MAIN ctid SPI same-key lookup;
 *               4-way promo dispatch (0/1/2/3): 0→INSERT, 1→MAIN-conflict,
 *               2→pure-delta conflict, 3→both-conflict; ON CONFLICT DO NOTHING /
 *               DO UPDATE SET col=EXCLUDED.col both branches; 9-row UPSERT full matrix
 *   Section T — apply_branch(bs_S_br) → bs_S_tbl MAIN materializes 9 rows, sum=1424,
 *               verifies UPSERT loses no rows / duplicates no rows
 *   Section U — discard_branch(bs_U_disc): T already applied 9 rows, MAIN stays intact,
 *               bs_U_disc rolls back 0 rows MAIN; sum MAIN=1424, sum bs_U pure del=0
 *   Section V — pg_branch_delta index layout invariant (WR-1 prereq): the internal delta table must only expose
 *               the PK (branch_id, relid, key), and must not have a (branch_id, relid) redundant index;
 *               and verifies, with M=2000 delta rows, that the write-path existence probe (conflict detection)
 *               resolves both the hit/miss paths correctly.
 *   Section W — R03 (UPSERT) pk-mutation guard: ON CONFLICT DO UPDATE whose
 *               SET targetlist touches a PK column must ERROR 0A000 on both
 *               promo=2 (MAIN conflict) and promo=3 (pure-delta conflict)
 *               before any delta row is written; a legal (non-PK) UPSERT still
 *               succeeds and MAIN stays pristine.  Also pins guard-flag
 *               restoration: an overlay read in the same transaction, after
 *               the caught 0A000, must still expose the delta.
 *   Section X — UPSERT DO UPDATE ... WHERE with a PASSING predicate on both
 *               promo=2 (MAIN conflict) and promo=3 (pure-delta conflict):
 *               the WHERE evaluation must not clear the caller's live
 *               pre-image / EXCLUDED slots.
 *   Section Y — (a) multi-row UPSERT with >= 2 consecutive promo=2/3 rows and
 *               a varlena SET column: the promo SET-merge projection must not
 *               clear the caller's live subplan slot (EXCLUDED); otherwise
 *               the following row reads a released tuple (lz4 corruption).
 *               (b) both-hit tie-break: when a key is present in MAIN *and*
 *               in the branch delta, the delta shadows MAIN, so a second
 *               UPSERT (or a UPSERT after an UPDATE) must build its post-image
 *               from the delta value, not the stale MAIN row.
 *   Section Z — EXPLAIN ANALYZE UPSERT conflict counters: because the write
 *               path bypasses standard_ExecutorRun(), the ModifyTable node's
 *               ntuples2 (Conflicting Tuples) and nfiltered1 (Rows Removed by
 *               Conflict Filter) must be accumulated manually, or the root
 *               node prints "(never executed)" and reports 0 conflicts.
 *               Pins DO UPDATE / DO NOTHING / DO UPDATE WHERE false / plain
 *               INSERT.
 *   Section AA — UPSERT rebirth after a branch-local DELETE: an op='D'
 *               tombstone shadows MAIN, so INSERT ... ON CONFLICT DO
 *               NOTHING / DO UPDATE ... WHERE false must rebirth the row
 *               instead of mis-reading the still-present MAIN row as a
 *               conflict (Phase I previously saw only op='I'/'U'); a
 *               genuine (non-deleted) MAIN conflict must still skip, and
 *               apply_branch materializes every rebirth.
 *   Section AB — same-statement duplicate arbiter keys (native parity): a
 *               single INSERT command that proposes the same PK twice must
 *               match upstream.  The redirect writes row-by-row and the
 *               command counter never advances between rows of one command,
 *               so the Phase I/II and R21 probes cannot see an earlier row
 *               of the same command; the loop tracks the arbiter keys it has
 *               already claimed for that statement — a later candidate whose
 *               key was already written errors (plain INSERT → 23505,
 *               DO UPDATE → 21000) or is skipped (DO NOTHING → first wins).
 *
 * ⚠️ Absolutely no DISCARD ALL / RESET between S→T→U: all three sections share the
 * catalog state of branches bs_S_br and bs_U_disc; if interrupted, Section T cannot find "bs_S_br" (already discarded in a different session).
 */
-- ===== 0. Prerequisite guard (same as the other regression files) =====
DO $$
DECLARE
  _s text := current_setting('shared_preload_libraries', true);
  _msg text;
BEGIN
  IF _s NOT LIKE '%overlay_branch%' THEN
    _msg := 'Postmaster started WITHOUT shared_preload_libraries=''overlay_branch''.  '
         || 'The 2 correct ways to invoke these tests (DON''T `cd test/` first):'
         || chr(10)||chr(10)||'  (A) make installcheck EXTRA_REGRESS_OPTS="--use-existing --host=/tmp --port=15433"'
         || chr(10)||'  (B) pg_regress overlay_branch_advanced \'
         || chr(10)||'         --inputdir=./test --outputdir=./test_output \'
         || chr(10)||'         --temp-config=$(pwd)/test/temp_instance_shared_libs.conf \'
         || chr(10)||'         --bindir=$(pg_config --bindir)'
         || chr(10)||chr(10);
    RAISE EXCEPTION '%', _msg;
  END IF;
END $$;
-- ===== Idempotent cleanup =====
SET client_min_messages = warning;
DROP TABLE IF EXISTS public.bs_user;
DROP TABLE IF EXISTS public.bs_basic;
DROP EXTENSION IF EXISTS overlay_branch CASCADE;
RESET client_min_messages;
CREATE EXTENSION IF NOT EXISTS overlay_branch;
SET client_min_messages = WARNING;
/* =========================================================== Section S */
-- =====================================================================
-- ===== Section S: Pure Delta UPSERT (ON CONFLICT ... DO UPDATE/NOTHING)
-- =====            2-phase MAIN-first conflict detection:
-- =====            Phase I pure-delta SPI, Phase II MAIN ctid SPI,
-- =====            4-way promo dispatch (0/1/2/3).
-- =====================================================================
-- Suppress minor TupleDesc resource-close WARNING (low-priority hygiene)
SET client_min_messages = error;
CREATE TABLE public.bs_S_up (id INT4 PRIMARY KEY, v INT4 NOT NULL, t TEXT DEFAULT 'main');
INSERT INTO public.bs_S_up SELECT g, g*10, 'main' FROM generate_series(1,5) g;
SELECT overlay_branch.create_branch('bs_S_br');
 create_branch 
---------------
             1
(1 row)

SELECT overlay_branch.use_branch('bs_S_br');
 use_branch 
------------
 
(1 row)

-- Pure seed: id=11 v=1 pure, id=55 v=555 pure (will be updated/preserved by S.2/S.6)
INSERT INTO public.bs_S_up VALUES (11, 1,   'pure');
INSERT INTO public.bs_S_up VALUES (55, 555, 'pure');
-- S.1 Case A promo=2: MAIN-conflict id=2 DO UPDATE SET v=EXCLUDED.v RETURNING
INSERT INTO public.bs_S_up VALUES (2, 205, 'excluded')
  ON CONFLICT (id) DO UPDATE SET v = EXCLUDED.v
  RETURNING id, v, t;
 id |  v  |  t   
----+-----+------
